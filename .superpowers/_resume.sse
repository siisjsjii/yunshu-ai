data: {"items": [{"n": 1, "chunk_id": 1036, "section_path": null, "question": "退货政策是怎么规定的", "answer": "自签收之日起 7 天内,商品完好、不影响二次销售的,支持七天无理由退货,但需保持商品完好、吊牌齐全 [3][2]。定制类、生鲜类商品不适用无理由退货 [3]。退货商品经平台核验通过后,退款将原路退回,具体到账时效以平台售后规则为准 [1]。", "category": "退换货"}, {"n": 2, "chunk_id": 632, "section_path": "退货退款政策 > 无理由退货 > 适用范围", "question": "适用范围", "answer": "自签收之日起 7 天内,商品完好、不影响二次销售的,支持无理由退货。定制类、生鲜类商品除外。", "category": "退货退款政策 > 无理由退货"}, {"n": 3, "chunk_id": 633, "section_path": "退货退款政策 > 无理由退货 > 退款时效", "question": "退款时效", "answer": "退货商品经平台核验通过后,退款原路退回,到账时效以平台售后规则为准。", "category": "退货退款政策 > 无理由退货"}, {"n": 4, "chunk_id": 652, "section_path": null, "question": "退货政策是什么", "answer": "支持七天无理由退货,商品需保持完好、吊牌齐全。", "category": "退换货"}, {"n": 5, "chunk_id": 605, "section_path": "商品与购物 FAQ > 退货政策是什么", "question": "退货政策是什么", "answer": "支持 7 天无理由退货,商品需保持完好、不影响二次销售,具体以平台售后规则为准。", "category": "商品与购物 FAQ"}]}

