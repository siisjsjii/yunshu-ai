# 必填,无默认值
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENAI_MODEL=<your-model-name>

# 数据库。实例由 Docker 提供,仓库不管理容器。
# MySQL 8.0 默认认证插件 caching_sha2_password 需要 cryptography 包。
DATABASE_URL=mysql+asyncmy://root:yourpassword@127.0.0.1:3307/mewhelp?charset=utf8mb4

# 以下均有默认值,按需覆盖
CHAT_TEMPERATURE=0.7
EXTRACT_TEMPERATURE=0.0
SAFETY_MARGIN_TOKENS=512
SESSION_TTL_SECONDS=1800
MAX_SESSIONS=1000
SESSION_LOCK_TIMEOUT_SECONDS=60
BRAND_NAME=云枢
TOOL_TIMEOUT_SECONDS=10
# ch08 起默认值是 2(共 3 次尝试,最坏 20.3s → 30.3s)。写 1 = 回退到 ch07 的行为。
# ⚠️ 写操作**永不重试**是结构保证(由工具的 kind 推出),不受这个数影响。
TOOL_RETRY_ATTEMPTS=2
TOOL_RETRY_DELAY_SECONDS=0.3

# ---- ch09 · 两个墙钟上界(T16b 起)。不设上界的后果不是"慢",是"永不返回"。----
#
# 每一次**模型往返**的上界(连接/读/写/池四相都用它)。默认 60s:本机实测最慢
# 一次调用约 4.5s ⇒ 约 13 倍余量。⚠️ 一次**逻辑调用**最坏 = (1+2)×这个值 + 退避
# (SDK 自己重试 max_retries=2),60s 对应最坏约 3 分钟。
# 若嫌"卡住的对话要等 3 分钟才报错"太久,调到 20–30 即可;要近似关掉写 86400。
LLM_TIMEOUT_SECONDS=60
# **整条飞轮任务**的上界(一条任务 = 一批)。默认 300s:实测一批 10 行约 30s
# ⇒ 约 10 倍余量。它与 FLYWHEEL_BATCH_SIZE 是一对,批量调大要一起看。
# 被它杀掉的那一批一行都不会落地(整批只提交一次),池子行下一轮重新吃到。
FLYWHEEL_JOB_TIMEOUT_SECONDS=300

# **整条评测任务**的上界(工作台「评测」页的「运行评测」按钮,ch10 跟进)。
# 它跑的是 scripts/run_eval.py 的**子进程**。实测一轮全量 300 条 × 四策略
# 在本机是 52 秒(2026-09-27,含重排权重的冷加载)⇒ 1800s 约 35 倍余量。
# ⚠️ 与飞轮那条同源:四条后台任务**共用一个运行槽**,没有这个界,
# 一次卡死的评测会把槽永久占死(此后每次触发都是 409)。
# 它只保「槽能拿回来」,不保「跑得完」——语料/用例长大了要一起看这个数。
EVAL_JOB_TIMEOUT_SECONDS=1800

# ---- Langfuse(ch09)。三个值任一为空 ⇒ 整套观测关闭。----
# 默认是 Langfuse Cloud 美国区。要"链路数据不出自家服务器"就换成自部署地址。
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
